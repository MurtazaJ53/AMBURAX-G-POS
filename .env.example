# Local development PostgreSQL (docker-compose.yml at the repository root).
# Copy to `.env` and choose your own local password. `.env` is gitignored.
# These credentials are DEVELOPMENT ONLY and must never be reused anywhere real.
POSTGRES_USER=amburax
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
POSTGRES_DB=amburax_identity
# 5432 and 5433 are commonly already in use; 55432 avoids collision.
POSTGRES_PORT=55432
