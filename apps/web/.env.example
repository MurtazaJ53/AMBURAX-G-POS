DATABASE_URL="postgresql://amburax:amburax@localhost:5432/amburax_identity"
SESSION_COOKIE_NAME="amburax_session"
SESSION_TTL_HOURS="12"
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
OTP_LENGTH="6"
OTP_TTL_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
OTP_MAX_RESENDS="5"
OTP_RESEND_COOLDOWN_SECONDS="30"
MFA_CHALLENGE_MAX_AGE_MINUTES="30"
# Dev-only: no SMS/WhatsApp/email provider is wired yet, so the OTP would otherwise be
# invisible outside server logs. Never set true in production.
DEV_OTP_ECHO="true"

APP_BASE_URL="http://localhost:3000"
RESET_TOKEN_TTL_MINUTES="30"
RESET_REQUEST_COOLDOWN_SECONDS="60"
RESET_REQUEST_MAX_PER_WINDOW="5"
RESET_CONSUME_MAX_PER_WINDOW="10"
# Dev-only, same contract as DEV_OTP_ECHO: no email provider is wired yet. Never true in production.
DEV_RESET_LINK_ECHO="true"

TENANT_REGISTRATION_MAX_PER_WINDOW="10"
ONBOARDING_SESSION_TTL_HOURS="48"
OWNER_SETUP_MAX_PER_WINDOW="10"
STORE_SETUP_MAX_PER_WINDOW="10"

INVITATION_TTL_HOURS="168"
INVITATION_RESEND_COOLDOWN_SECONDS="60"
INVITATION_CREATE_MAX_PER_WINDOW="20"
INVITATION_RESEND_MAX_PER_WINDOW="20"
TEAM_STEP_MAX_PER_WINDOW="20"
# A11 — invitation acceptance attempts per rate-limit window, per identifier
INVITATION_ACCEPT_MAX_PER_WINDOW="15"
# A10 — onboarding completion
ONBOARDING_COMPLETE_MAX_PER_WINDOW="20"
# A9 — POS terminal setup, skip step, and device pairing
POS_SETUP_MAX_PER_WINDOW="20"
POS_STEP_MAX_PER_WINDOW="20"
POS_PAIRING_TTL_MINUTES="60"
POS_ACTIVATE_MAX_PER_WINDOW="10"
# Dev-only, same contract as DEV_OTP_ECHO/DEV_RESET_LINK_ECHO: no email provider is
# wired yet, so the invite link would otherwise only exist in server logs.
# Never true in production.
DEV_INVITE_LINK_ECHO="true"
