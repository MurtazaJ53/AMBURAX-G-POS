// A selling-price change waiting for older stock to sell through.
//
// The retail problem it solves: a shirt restocks with a higher MRP printed on the new tags, but
// the shelf still holds units tagged at the old MRP, and those may never be charged above what
// their tag says. So the new price is queued, not applied: `unitsAhead` starts at the number of
// units on hand before the delivery arrived, every unit that leaves stock (sale, write-off,
// count shortfall) is taken off it — oldest first, which is how a shelf actually empties — and
// the price switches by itself, inside the transaction that sold the last older unit.
//
// Tenant-wide, because the selling price is: the variant has one price, so "older stock" means
// every older unit in every store.
//
// Rows are never deleted. APPLIED and CANCELLED rows are the history of why a price changed.
model PendingPriceChange {
  id        String @id @default(cuid())
  tenantId  String
  variantId String

  newPriceMinor Int
  newMrpMinor   Int?

  // What the price was when this was queued, so the history reads "999 to 1199" without
  // reconstructing it.
  previousPriceMinor Int
  previousMrpMinor   Int?

  // Older units still to leave stock before this price takes over. Decremented atomically by
  // the stock ledger; at or below zero the change applies.
  unitsAhead Int

  status PriceChangeStatus @default(PENDING)

  // The receipt that brought in the new-price stock.
  sourceMovementId String?
  actorUserId      String?

  createdAt DateTime  @default(now())
  appliedAt DateTime?

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  variant ProductVariant @relation(fields: [variantId, tenantId], references: [id, tenantId])

  @@index([tenantId, variantId, status])
  @@map("pending_price_changes")
}

enum PriceChangeStatus {
  PENDING
  APPLIED
  // Superseded by a later decision: a price set directly, or a newer receipt that changed the
  // price for all stock at once.
  CANCELLED
}

