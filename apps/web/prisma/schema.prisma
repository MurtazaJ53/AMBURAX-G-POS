  reversedBy KhataAdvanceEntry[] @relation("AdvanceReversal")

  @@unique([tenantId, idempotencyKey])
  @@unique([id, tenantId, companyId, customerId, creditAccountId, currency], map: "uq_adv_full_scope_entry")
  @@index([tenantId, companyId, customerId, createdAt], map: "khata_advance_entries_tenantId_companyId_customerId_createdAt_i")
  @@index([khataPaymentId])
  @@map("khata_advance_entries")
