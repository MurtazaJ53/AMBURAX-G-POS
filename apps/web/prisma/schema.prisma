model KhataPaymentAllocation {
  id              String @id @default(cuid())
  tenantId        String
  companyId       String
  customerId      String
  creditAccountId String
  currency        String
  khataPaymentId  String
  saleId          String
  amountMinor     Int

  createdAt DateTime @default(now())

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], map: "fk_kpa_tenant")
  company           Company                @relation(fields: [companyId, tenantId], references: [id, tenantId], map: "fk_kpa_company")
  customer          Customer               @relation(fields: [customerId, tenantId], references: [id, tenantId], map: "fk_kpa_customer")
  creditAccount     CustomerCreditAccount  @relation(fields: [creditAccountId, tenantId, companyId, customerId, currency], references: [id, tenantId, companyId, customerId, currency], map: "fk_kpa_credit_account")
  khataPayment      KhataPayment           @relation("KhataPaymentAllocations", fields: [khataPaymentId, tenantId], references: [id, tenantId], map: "fk_kpa_payment")
  // The allocation must share its payment's full ledger scope (tenant, company, customer, credit
  // account, currency), not only its id. Overlaps the plain id relation on purpose.
  khataPaymentScope KhataPayment           @relation("KhataPaymentAllocationScope", fields: [khataPaymentId, tenantId, companyId, customerId, creditAccountId, currency], references: [id, tenantId, companyId, customerId, creditAccountId, currency], onDelete: Restrict, map: "fk_kpa_payment_full_scope")
  sale              Sale                   @relation(fields: [saleId, tenantId], references: [id, tenantId], map: "fk_kpa_sale")
