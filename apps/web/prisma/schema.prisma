enum KhataReceivableEntryType {
  DEBIT_CREDIT_SALE
  CREDIT_REPAYMENT
  CREDIT_SALE_RETURN
  CREDIT_ADVANCE_APPLY
  DEBIT_REVERSAL
  CREDIT_REVERSAL
}

enum KhataAdvanceEntryType {
  CREDIT_ADVANCE_DEPOSIT
  DEBIT_APPLICATION
  DEBIT_REFUND
  DEBIT_REVERSAL
  CREDIT_REVERSAL
}

/// Udhar (counter credit) mode. There is no "unset": a missing or invalid mode is BLOCKED, and
/// UNLIMITED is explicit, never inferred from a null limit.
enum CreditMode {
  BLOCKED
  UNLIMITED
  LIMITED
}

/// How a credit account's mode was set. MIGRATED: the account predates credit modes.
enum CreditModeSource {
  COMPANY_DEFAULT
  OWNER_OVERRIDE
  MIGRATED
}

model Company {
  id                      String     @id @default(cuid())
  tenantId                String
  name                    String
  code                    String
  currency                String
  defaultPaymentTermsDays Int        @default(0)
  /// Udhar mode copied onto a customer's credit account when that account is created. Changing
  /// it never rewrites existing accounts. Limit: positive when LIMITED, otherwise null (CHECK).
  defaultCreditMode       CreditMode @default(BLOCKED)
  defaultCreditLimitMinor Int?
  /// E4 (owner 2026-10-14): finance-supplied ERPNext accounts for till differences. Both must be set
  /// before any cash over/short Journal Entry is posted; AMBURAX never guesses them.
  erpCashAccount          String?
  erpCashOverShortAccount String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], map: "fk_companies_tenant")
  stores                 Store[]
  sales                  Sale[]
  customerCreditAccounts CustomerCreditAccount[]
  receivableEntries      KhataReceivableEntry[]
  advanceEntries         KhataAdvanceEntry[]
  paymentAllocations     KhataPaymentAllocation[]
  advanceAllocations     KhataAdvanceAllocation[]
  khataPayments          KhataPayment[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@unique([id, tenantId, currency])
  @@map("companies")
}

model CustomerCreditAccount {
  id                   String           @id @default(cuid())
  tenantId             String
  companyId            String
  customerId           String
  currency             String
  creditLimitMinor     Int?
  creditEnabled        Boolean          @default(false)
  creditHold           Boolean          @default(false)
  /// This account's own Udhar mode, frozen from the Company default at creation. Separate from
  /// the legacy `creditLimitMinor`. Limit: positive when LIMITED, otherwise null (CHECK).
  creditMode           CreditMode       @default(BLOCKED)
  creditModeLimitMinor Int?
  creditModeSource     CreditModeSource @default(MIGRATED)
  creditModeSetAt      DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], map: "fk_cca_tenant")
  company            Company                  @relation(fields: [companyId, tenantId], references: [id, tenantId], map: "fk_cca_company")
  customer           Customer                 @relation(fields: [customerId, tenantId], references: [id, tenantId], map: "fk_cca_customer")
  receivableEntries  KhataReceivableEntry[]
  advanceEntries     KhataAdvanceEntry[]
  paymentAllocations KhataPaymentAllocation[]
  advanceAllocations KhataAdvanceAllocation[]
  khataPayments      KhataPayment[]

  @@unique([tenantId, companyId, customerId])
  @@unique([id, tenantId, companyId, customerId, currency], map: "customer_credit_accounts_id_tenantId_companyId_customerId_curre")
  @@map("customer_credit_accounts")
}

model KhataReceivableEntry {
  id              String @id @default(cuid())
  tenantId        String
  companyId       String
  customerId      String
  creditAccountId String
  currency        String

  entryType   KhataReceivableEntryType
  amountMinor Int

  // Source Lineage Links
  saleId              String?
  paymentAllocationId String?
  allocationId        String?
  saleReturnId        String?

  // Reversal Pointers (Full 6-tuple parent pointer)
  reversalOfId         String?
  reversalOfTenantId   String?
  reversalOfCompanyId  String?
  reversalOfCustomerId String?
  reversalOfAccountId  String?
  reversalOfCurrency   String?

  actorUserId    String
  notes          String?
  idempotencyKey String
  createdAt      DateTime @default(now())

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], map: "fk_rec_tenant")
  company           Company                 @relation(fields: [companyId, tenantId], references: [id, tenantId], map: "fk_rec_company")
  customer          Customer                @relation(fields: [customerId, tenantId], references: [id, tenantId], map: "fk_rec_customer")
  creditAccount     CustomerCreditAccount   @relation(fields: [creditAccountId, tenantId, companyId, customerId, currency], references: [id, tenantId, companyId, customerId, currency], map: "fk_rec_credit_account")
  sale              Sale?                   @relation(fields: [saleId, tenantId], references: [id, tenantId], map: "fk_rec_sale")
  paymentAllocation KhataPaymentAllocation? @relation(fields: [paymentAllocationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "fk_rec_payment_allocation")
  advanceAllocation KhataAdvanceAllocation? @relation(fields: [allocationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "fk_rec_advance_allocation")
  saleReturn        SaleReturn?             @relation(fields: [saleReturnId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "fk_rec_sale_return")

  reversalOf KhataReceivableEntry?  @relation("ReceivableReversal", fields: [reversalOfId, reversalOfTenantId, reversalOfCompanyId, reversalOfCustomerId, reversalOfAccountId, reversalOfCurrency], references: [id, tenantId, companyId, customerId, creditAccountId, currency], onDelete: Restrict, map: "fk_rec_reversal_parent")
  reversedBy KhataReceivableEntry[] @relation("ReceivableReversal")

  @@unique([tenantId, idempotencyKey])
  @@unique([id, tenantId, companyId, customerId, creditAccountId, currency], map: "uq_rec_full_scope_entry")
  @@index([tenantId, companyId, customerId, createdAt], map: "khata_receivable_entries_tenantId_companyId_customerId_createdA")
  @@index([saleId])
  @@map("khata_receivable_entries")
