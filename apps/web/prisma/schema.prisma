// AMBURAX Identity service data model.
// Amburax-owned domain (see DATA_STRATEGY.md): tenant/platform metadata, sessions, audit.
// ERPNext is NOT touched by this schema — no stock, accounting or ERP transactions live here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// Tenant-level role, distinct from StoreMembership.role (which is store-scoped, e.g.
// "MANAGER"). Not a separate join table: User.tenantId is already a hard 1:1 FK (one
// user belongs to exactly one tenant), so a "tenant membership" table would just
// duplicate that fact. OWNER is set exactly once, by A6, for the tenant's first user.
enum TenantRole {
  OWNER
  STAFF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// Generic retail/commerce verticals — garment depth lives in later, garment-specific
// screens (see BRUTAL_TRUTH.md / PROJECT.md), not in the tenant shape itself.
enum BusinessType {
  RETAIL
  WHOLESALE
  MANUFACTURING
  SERVICES
  DISTRIBUTION
  OTHER
}

// The onboarding lifecycle A5-A10 advance through, independent of TenantStatus
// (which is an operational on/off switch, not a setup-progress tracker — conflating
// the two would make "is this tenant suspended" and "has this tenant finished
// onboarding" the same field, which they are not).
enum OnboardingStep {
  BUSINESS_CREATED
  OWNER_CREATED
  STORE_CREATED
  TEAM_INVITED
  POS_CONFIGURED
  COMPLETE
}

// ERPNext site/company provisioning is explicitly asynchronous and NOT performed by
// A5 — no ERPNext adapter exists yet (Phase 2). This models the eventual state
// machine honestly (NOT_PROVISIONED until a real adapter flips it) rather than
// pretending synchronous ERPNext setup happened. See DECISIONS.md.
enum ErpnextProvisionStatus {
  NOT_PROVISIONED
  PROVISIONING
  PROVISIONED
  FAILED
}

model Tenant {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  status          TenantStatus @default(ACTIVE)
  businessType    BusinessType
  industry        String?
  country         String
  taxId           String?
  contactEmail    String
  contactPhone    String
  termsAcceptedAt DateTime

  // Idempotency anchor for POST /tenants: a client-generated key, replayed on
  // double-click/retry/refresh, maps back to this same tenant instead of creating
  // a second one. Nullable+unique so other, non-self-serve creation paths (future
  // admin tooling) aren't forced to fabricate one. See DECISIONS.md.
  registrationKey String? @unique

  onboardingStep        OnboardingStep @default(BUSINESS_CREATED)
  onboardingCompletedAt DateTime?

  erpnextProvisionStatus ErpnextProvisionStatus @default(NOT_PROVISIONED)
  erpnextSiteId          String?

  createdAt DateTime @default(now())

  users              User[]
  stores             Store[]
  posDevices         PosDevice[]
  outboxEvents       OutboxEvent[]
  products           Product[]
  customers          Customer[]
  sales              Sale[]
  onboardingSessions OnboardingSession[]
  invitations        Invitation[]

  @@map("tenants")
}

// Bridges an anonymous registrant (A5) to the tenant they're setting up, before any
// User exists to hold a real Session. Deliberately not reusing Session — a Session's
// whole contract is "belongs to a real authenticated user," which is untrue here.
// Valid until expiresAt OR the tenant's onboardingStep reaches COMPLETE.
model OnboardingSession {
  id        String   @id @default(cuid())
  tenantId  String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("onboarding_sessions")
}

// Store IS the Amburax-side location/warehouse concept — see ERPNEXT_DOCTYPE_MAP.md
// ("Store -> Warehouse/Company setup"). No separate Location/Warehouse model: that would
// be a second, duplicate inventory concept living outside ERPNext, which the architecture
// explicitly forbids. `erpnextProvisionStatus`/`erpnextWarehouseId` mirror Tenant's own
// deferred-ERPNext fields (ADR-038) — no adapter exists yet, so these stay at their
// defaults; nothing here pretends a Warehouse was actually provisioned in ERPNext.
enum StoreType {
  RETAIL
  WAREHOUSE
}

model Store {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  storeType   StoreType @default(RETAIL)
  currency    String
  phone       String?
  addressLine String
  city        String
  state       String
  postalCode  String?
  timezone    String    @default("Asia/Kolkata")
  // True for exactly one store per tenant. Not exposed as a user toggle at A7 (there is
  // nothing to toggle against yet — the first store is trivially the default); future
  // multi-store screens are what make this field meaningful.
  isDefault   Boolean   @default(false)

  erpnextProvisionStatus ErpnextProvisionStatus @default(NOT_PROVISIONED)
  erpnextWarehouseId     String?

  // Per-store bill counter. Incremented inside the sale transaction, so PostgreSQL's row
  // lock serialises concurrent tills and two sales can never take the same number.
  // This is an AMBURAX *retail reference*, NOT an ERPNext invoice number — invoice
  // numbering stays ERPNext-authoritative (ADR-063). See ADR-079.
  nextBillSeq Int @default(1)

  createdAt DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  memberships StoreMembership[]
  invitations Invitation[]
  posDevices  PosDevice[]
  sales       Sale[]
  stockLevels StockLevel[]

  @@unique([tenantId, code])
  @@map("stores")
}

// A9's model. A POS terminal is an *operational device* bound to a Store — deliberately
// not a User (a device does not log in, does not hold a role, and must be revocable
// without touching any person's identity), not a Store (a Store has many terminals), and
// not a Warehouse (Store already is the Amburax-side warehouse concept — see the Store
// model above). OFFLINE_POS.md §9 requires exactly this shape: Tenant -> Store -> POS
// Terminal -> Device, so the server can attribute every offline transaction to the device
// that produced it.
//
// The fields are deliberately grouped into three kinds that must not be conflated:
//   IDENTITY       — stable, server-assigned, never re-derived from a browser fingerprint.
//   CREDENTIALS    — two *different* secrets with different lifetimes (see below).
//   CONFIGURATION  — merchant-chosen presentation/hardware behaviour, Amburax-owned.
//   RUNTIME        — volatile, written only by device-facing calls, never by A9's form.
//
// Two distinct credentials, not one:
//   `pairingCodeHash`  — one-time, short-lived, shown to the *owner* once at A9 so they can
//                        pair the physical terminal. Consumed at activation.
//   `deviceSecretHash` — long-lived, issued to the *device* at activation and never shown
//                        to a human. This is what a future POS client authenticates with.
// Neither reuses Session / OnboardingSession / PasswordResetToken / MfaChallenge /
// Invitation: a device credential has a different subject (a machine), a different
// lifetime, and a different revocation story. Only `token.ts`'s hash helper is shared.
//
// Status is derived from nullable timestamps (activatedAt / disabledAt / pairingExpiresAt),
// matching the Invitation/PasswordResetToken convention — one source of truth per fact
// instead of a status column that can drift. Crucially `createdAt` != `activatedAt`: a row
// existing means "the owner configured a terminal", NOT "a physical terminal has claimed
// it". A9 must never report the second when only the first is true.
//
// Revocation is `disabledAt`, never deletion: historical sales will reference `posDeviceId`
// forever, so a compromised terminal must be disableable without destroying its history.
model PosDevice {
  id       String @id @default(cuid())
  tenantId String
  storeId  String

  // --- IDENTITY ---
  // `code` is the logical terminal name the merchant uses on the floor (POS-01, POS-02).
  // Unique per store, not per tenant: two stores may each have their own POS-01.
  name            String
  code            String
  createdByUserId String
  createdAt       DateTime @default(now())

  // --- CREDENTIALS (raw values are never persisted) ---
  pairingCodeHash  String?   @unique
  pairingExpiresAt DateTime?
  deviceSecretHash String?   @unique

  // --- LIFECYCLE (status derived from these) ---
  activatedAt DateTime?
  disabledAt  DateTime?

  // --- RUNTIME (volatile — not configuration) ---
  // Written by device-facing calls only. A heartbeat/online-offline/sync-state model
  // belongs with the offline engine (OFFLINE_POS.md §4), not here; this single column
  // is the minimum A9 needs to tell "activated once" from "actually seen".
  lastSeenAt DateTime?

  // --- CONFIGURATION (Amburax-owned presentation/hardware behaviour) ---
  // Deliberately excludes invoice prefix / start number / default customer / price list,
  // even though the A9 wireframe sketches them: numbering is ERPNext-authoritative
  // (OFFLINE_POS.md §10) and customers/price lists are ERPNext-owned records that no
  // Amburax model or adapter can validate against yet. See DECISIONS.md ADR-063.
  receiptHeader     String?
  receiptFooter     String?
  showProductImages Boolean @default(true)
  scanSoundEnabled  Boolean @default(true)
  cashDrawerEnabled Boolean @default(false)

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  store     Store  @relation(fields: [storeId], references: [id])
  createdBy User   @relation("PosDevicesCreated", fields: [createdByUserId], references: [id])

  @@unique([storeId, code])
  @@index([tenantId])
  @@index([storeId])
  @@map("pos_devices")
}

model User {
  id               String     @id @default(cuid())
  tenantId         String
  email            String     @unique
  passwordHash     String
  name             String
  status           UserStatus @default(ACTIVE)
  tenantRole       TenantRole @default(STAFF)
  mfaEnabled       Boolean    @default(false)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  sessions            Session[]
  memberships         StoreMembership[]
  mfaChallenges       MfaChallenge[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationsSent")
  invitationsAccepted Invitation[]         @relation("InvitationsAccepted")
  posDevicesCreated   PosDevice[]          @relation("PosDevicesCreated")
  salesRung           Sale[]               @relation("SalesRung")

  @@index([tenantId])
  @@map("users")
}

// `role` is a free string (not a schema enum) matching the existing convention since A1 —
// changing its type would touch working A7 infrastructure the brief asked not to rebuild.
// The privilege-escalation guard therefore lives in code, not the column type: see
// src/server/tenant/storeRoles.ts's INVITABLE_STORE_ROLES allow-list, enforced at
// invitation creation (this file) and to be enforced identically wherever A11 later
// creates the membership row from an accepted invitation.
model StoreMembership {
  id      String @id @default(cuid())
  userId  String
  storeId String
  role    String

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@map("store_memberships")
}

// A8's credential: proves "the tenant's owner invited this email to this store with this
// role," nothing more. Deliberately its own model, not a reuse of Session, OnboardingSession,
// PasswordResetToken, or MfaChallenge — see AUTHENTICATION.md's "pre-auth credential types."
// `role` is validated against INVITABLE_STORE_ROLES at creation (never OWNER, never a future
// platform-admin role) — the payload itself cannot be used for privilege escalation.
//
// Status is deliberately derived (not a stored enum) from three nullable timestamps —
// acceptedAt / revokedAt / expiresAt — mirroring PasswordResetToken/MfaChallenge/
// OnboardingSession's established convention, so there's one source of truth per fact
// instead of a status column that could drift from the timestamps.
//
// A11 (not built yet) must accept an invitation with the same atomic-claim shape as A4's
// token-race fix (ADR-031): `updateMany({ where: { id, acceptedAt: null, revokedAt: null,
// expiresAt: { gt: now } }, data: { acceptedAt: now, acceptedByUserId } })` as the first
// statement in its transaction. Documented here so A11 doesn't have to rediscover it.
//
// @@unique([tenantId, storeId, email]) is deliberate, not incidental: it makes "invite
// this email to this store" a single atomic `upsert` rather than a read-then-write
// (check for a pending invite, then create) — the latter raced under concurrent
// double-clicks (two overlapping transactions could each pass the "no pending invite
// yet" check before either committed, producing two live invitations for the same
// email+store). One row per (tenant, store, email) forever, refreshed on every new
// invite, closes that race at the database level instead of trying to out-time it.
model Invitation {
  id               String    @id @default(cuid())
  tenantId         String
  storeId          String
  email            String
  role             String
  inviterUserId    String
  tokenHash        String    @unique
  createdAt        DateTime  @default(now())
  lastSentAt       DateTime  @default(now())
  resendCount      Int       @default(0)
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  store      Store  @relation(fields: [storeId], references: [id])
  inviter    User   @relation("InvitationsSent", fields: [inviterUserId], references: [id])
  acceptedBy User?  @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id])

  @@unique([tenantId, storeId, email])
  @@index([tenantId])
  @@index([email])
  @@index([storeId])
  @@map("invitations")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String
  tokenHash String    @unique
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// Durable rate-limit + audit source for login/MFA attempts (LoginSucceeded/LoginFailed, MFA verify/resend).
// `context` scopes the IP rate-limit window per attempt type so a burst of OTP
// guesses can't be laundered through the plain-login limiter or vice versa.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  context   String   @default("password")
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, context, createdAt])
  @@map("login_attempts")
}

enum MfaChannel {
  SMS
  WHATSAPP
  EMAIL
}

// One row per OTP challenge issued after a password-correct, MFA-required login.
// tokenHash identifies the challenge to the client (opaque, like Session.tokenHash);
// codeHash is the OTP itself. Neither the raw token nor the raw code is ever persisted.
model MfaChallenge {
  id          String     @id @default(cuid())
  userId      String
  tenantId    String
  tokenHash   String     @unique
  codeHash    String
  channel     MfaChannel @default(SMS)
  attempts    Int        @default(0)
  resendCount Int        @default(0)
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  lastSentAt  DateTime   @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_challenges")
}

// One row per password reset request that actually issued a token (silent no-op
// requests — unknown email, disabled account, within cooldown — create no row,
// by design: the response is identical either way, so nothing here should be
// queryable as a "did this email request a reset" oracle beyond what's already
// implied by the user existing at all).
// Issuing a new token supersedes (consumes) every prior unconsumed token for the
// same user — see DECISIONS.md ADR-027. Only one reset link is ever valid at a time.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

// ADR-010's durable outbox. Closes audit finding P1-4.
//
// Why this is NOT AuditLog. `writeAuditLog` uses the global `db` client, so all 53 of its
// call sites write *outside* the business transaction: if the transaction rolls back the
// audit row survives, and if the process dies after committing the mutation the audit row
// never appears. Either way the record and the fact disagree. That is acceptable for an
// operator's action trail, which is what AuditLog is; it is fatal for a domain event,
// which something downstream must act on. The two coexist and mean different things —
// AuditLog answers "who did what", OutboxEvent answers "what must happen next".
//
// The transactional guarantee is the entire point: a row here is INSERTed by the same
// PostgreSQL transaction as the mutation it describes (see events/outbox.ts, which only
// accepts a Prisma.TransactionClient). So the event exists if and only if the business
// change committed. No two-phase commit, no lost events, no phantom events.
//
// Envelope fields are EVENTS.md's "Event requirements" list verbatim: event_id (`id`),
// event_type, event_version, occurred_at, tenant_id, store_id, actor, correlation_id,
// causation_id, entity_id, payload.
//
// Delivery state is derived from nullable timestamps (publishedAt / deadLetteredAt),
// matching the Invitation / PasswordResetToken / PosDevice convention — one source of
// truth per fact instead of a status column that can drift from them.
model OutboxEvent {
  id String @id @default(cuid())

  // --- ENVELOPE ---
  // tenantId is required and FK-enforced: an event that cannot be attributed to a tenant
  // cannot be dispatched safely, and every read path scopes on it.
  tenantId      String
  storeId       String?
  eventType     String
  eventVersion  Int      @default(1)
  occurredAt    DateTime @default(now())
  actorUserId   String?
  correlationId String
  causationId   String?
  entityId      String?
  payload       Json

  // Producer-side deduplication. Deterministically derived from the business fact
  // (tenant + event type + entity + discriminator), so a retried operation that reaches
  // the insert twice is rejected by the database rather than enqueuing a duplicate.
  // Consumer-side idempotency is still required — delivery is at-least-once by design.
  idempotencyKey String @unique

  // --- DELIVERY STATE ---
  // `attempts` and `nextAttemptAt` are advanced by the claim itself, so a dispatcher that
  // crashes mid-publish cannot hot-loop: the row is already scheduled into the future.
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  publishedAt    DateTime?
  deadLetteredAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // The dispatcher's hot path: unpublished, not dead-lettered, due now, oldest first.
  @@index([publishedAt, deadLetteredAt, nextAttemptAt])
  @@index([tenantId, occurredAt])
  @@map("outbox_events")
}

// -----------------------------------------------------------------------------
// RETAIL COMMERCE DOMAIN
//
// Money is stored as INTEGER MINOR UNITS (paise) everywhere, never as Float. Binary
// floating point cannot represent 0.1 exactly, and a POS that accumulates rounding error
// across a day's takings reconciles to nothing. Every `*Minor` column is an exact integer
// count of the smallest currency unit.
//
// Tax rates are stored in BASIS POINTS (`taxRateBp`): 1800 == 18.00%. Same reasoning.
//
// What this domain does NOT do: it is not an accounting system and not a stock ledger.
// ERPNext remains authoritative for the Sales Invoice, Payment Entry, GL impact and the
// stock ledger (ADR-001, ERPNEXT_ARCHITECTURE.md). These tables hold the AMBURAX retail
// record and the operational projection needed to run a counter - see StockLevel.
// -----------------------------------------------------------------------------

model Product {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  category String?
  brand    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  variants ProductVariant[]

  @@index([tenantId, name])
  @@map("products")
}

// The sellable unit. A non-garment retailer simply has one variant per product with null
// size/colour - the model stays generic rather than assuming apparel, while `size`/`colour`
// give the garment-first vertical first-class columns instead of burying them in JSON.
model ProductVariant {
  id        String @id @default(cuid())
  tenantId  String
  productId String

  sku     String
  barcode String?
  size    String?
  colour  String?

  // Selling price and MRP in minor units. `taxRateBp` is the rate configured on the
  // variant; the rate actually charged is snapshotted onto the sale line.
  priceMinor Int
  mrpMinor   Int?
  taxRateBp  Int  @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product     Product      @relation(fields: [productId], references: [id])
  saleItems   SaleItem[]
  stockLevels StockLevel[]

  // SKU and barcode are unique per tenant, not globally: two businesses may legitimately
  // use the same SKU string, and a global constraint would leak one tenant's namespace
  // into another's.
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model Customer {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sales  Sale[]

  // Phone is the retail identity key in this market. Unique per tenant so selecting an
  // existing customer can never silently create a duplicate.
  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

// COMPLETED means AMBURAX holds the sale. It does NOT mean ERPNext posted an invoice -
// `erpSyncStatus` carries that separately and honestly (OFFLINE_POS.md section 16).
enum SaleStatus {
  COMPLETED
  VOIDED
}

enum ErpSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Sale {
  id       String @id @default(cuid())
  tenantId String
  storeId  String

  // Human-facing retail reference, unique per store, allocated from Store.nextBillSeq
  // inside the sale transaction. NOT an ERPNext invoice number (ADR-063 / ADR-079).
  billNumber String

  cashierUserId String
  customerId    String?

  status SaleStatus @default(COMPLETED)

  // Every amount is server-calculated from the variant's stored price. Nothing here is
  // ever taken from the browser - see saleService.ts.
  subtotalMinor Int
  discountMinor Int @default(0)
  taxMinor      Int
  totalMinor    Int
  paidMinor     Int

  // Client-supplied request identity. Unique per tenant, so a double-click, a browser
  // retry or a network retry returns the original sale instead of ringing it twice.
  idempotencyKey String

  // ERPNext is not connected. PENDING is the truthful state, not a placeholder for
  // success - the UI must say "ERP sync pending", never "posted to ERPNext".
  erpSyncStatus ErpSyncStatus @default(PENDING)
  erpInvoiceId  String?

  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  store    Store         @relation(fields: [storeId], references: [id])
  cashier  User          @relation("SalesRung", fields: [cashierUserId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  payments SalePayment[]

  @@unique([tenantId, idempotencyKey])
  @@unique([storeId, billNumber])
  @@index([tenantId, completedAt])
  @@index([storeId, completedAt])
  @@map("sales")
}

// Line values are SNAPSHOTS taken at the moment of sale. A later price change must never
// retroactively alter what a customer was charged, so name, sku and unit price are copied
// here rather than joined from the variant at read time.
model SaleItem {
  id     String @id @default(cuid())
  saleId String

  variantId    String
  skuSnapshot  String
  nameSnapshot String

  quantity          Int
  unitPriceMinor    Int
  lineDiscountMinor Int @default(0)
  taxRateBp         Int
  taxMinor          Int
  lineTotalMinor    Int

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

// A sale may be settled by more than one tender. No payment gateway is integrated, so
// CASH/UPI/CARD are all operator-confirmed at the counter - `reference` holds a UPI or
// card reference the operator typed. A timeout must never become CONFIRMED.
model SalePayment {
  id     String @id @default(cuid())
  saleId String

  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountMinor Int
  reference   String?
  confirmedAt DateTime?

  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

// AMBURAX OPERATIONAL STOCK PROJECTION - NOT AN AUTHORITATIVE STOCK LEDGER.
//
// ERPNext owns the stock ledger (ADR-001, DATA_OWNERSHIP_MATRIX.md). This table exists so a
// counter can show an on-hand figure and so a sale visibly moves stock, and it is
// explicitly a read/operational projection: no valuation, no costing, no stock entries, no
// accounting impact, and rebuildable from ERPNext once the adapter exists.
//
// It must never be presented as a confirmed global stock figure - the UI labels it as an
// operational count, per OFFLINE_POS.md section 14's "local estimate" rule. See ADR-080.
model StockLevel {
  id        String @id @default(cuid())
  tenantId  String
  storeId   String
  variantId String

  // Signed on purpose: a projection that has drifted negative is information, and clamping
  // it at zero would hide the drift a reconciliation sweep needs to find.
  quantity Int @default(0)

  updatedAt DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([storeId, variantId])
  @@index([tenantId])
  @@map("stock_levels")
}

model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String?
  userId        String?
  action        String
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
