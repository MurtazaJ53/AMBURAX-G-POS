  @@unique([id, tenantId, companyId, customerId, creditAccountId, currency], map: "uq_kpa_full_scope")
  @@unique([id, tenantId], map: "uq_kpa_id_tenant")
  @@index([tenantId, khataPaymentId])
  @@index([tenantId, saleId])
  @@map("khata_payment_allocations")
}

model KhataAdvanceAllocation {
  id              String @id @default(cuid())
  tenantId        String
  companyId       String
