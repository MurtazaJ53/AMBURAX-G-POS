// AMBURAX Identity service data model.
// Amburax-owned domain (see DATA_STRATEGY.md): tenant/platform metadata, sessions, audit.
// ERPNext is NOT touched by this schema — no stock, accounting or ERP transactions live here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// Tenant-level role, distinct from StoreMembership.role (which is store-scoped, e.g.
// "MANAGER"). Not a separate join table: User.tenantId is already a hard 1:1 FK (one
// user belongs to exactly one tenant), so a "tenant membership" table would just
// duplicate that fact. OWNER is set exactly once, by A6, for the tenant's first user.
enum TenantRole {
  OWNER
  STAFF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// Generic retail/commerce verticals — garment depth lives in later, garment-specific
// screens (see BRUTAL_TRUTH.md / PROJECT.md), not in the tenant shape itself.
enum BusinessType {
  RETAIL
  WHOLESALE
  MANUFACTURING
  SERVICES
  DISTRIBUTION
  OTHER
}

// The onboarding lifecycle A5-A10 advance through, independent of TenantStatus
// (which is an operational on/off switch, not a setup-progress tracker — conflating
// the two would make "is this tenant suspended" and "has this tenant finished
// onboarding" the same field, which they are not).
enum OnboardingStep {
  BUSINESS_CREATED
  OWNER_CREATED
  STORE_CREATED
  TEAM_INVITED
  POS_CONFIGURED
  COMPLETE
}

// ERPNext site/company provisioning is explicitly asynchronous and NOT performed by
// A5 — no ERPNext adapter exists yet (Phase 2). This models the eventual state
// machine honestly (NOT_PROVISIONED until a real adapter flips it) rather than
// pretending synchronous ERPNext setup happened. See DECISIONS.md.
enum ErpnextProvisionStatus {
  NOT_PROVISIONED
  PROVISIONING
  PROVISIONED
  FAILED
}

model Tenant {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  status          TenantStatus @default(ACTIVE)
  businessType    BusinessType
  industry        String?
  country         String
  taxId           String?
  contactEmail    String
  contactPhone    String
  termsAcceptedAt DateTime

  // Idempotency anchor for POST /tenants: a client-generated key, replayed on
  // double-click/retry/refresh, maps back to this same tenant instead of creating
  // a second one. Nullable+unique so other, non-self-serve creation paths (future
  // admin tooling) aren't forced to fabricate one. See DECISIONS.md.
  registrationKey String? @unique

  onboardingStep        OnboardingStep @default(BUSINESS_CREATED)
  onboardingCompletedAt DateTime?

  erpnextProvisionStatus ErpnextProvisionStatus @default(NOT_PROVISIONED)
  erpnextSiteId          String?

  createdAt DateTime @default(now())

  users              User[]
  stores             Store[]
  posDevices         PosDevice[]
  posSessions        PosSession[]
  outboxEvents       OutboxEvent[]
  products           Product[]
  customers          Customer[]
  sales              Sale[]
  onboardingSessions OnboardingSession[]
  invitations        Invitation[]
  stockMovements     StockMovement[]
  uoms               Uom[]
  uomConversions     UomConversion[]
  addresses          Address[]
  customerAddresses  CustomerAddress[]
  priceLists         PriceList[]
  priceListItems     PriceListItem[]
  capabilities       TenantCapability[]
  orders             Order[]

  // The tenant's fallback price list, tried after the customer's and the store's. A pointer
  // rather than an `isDefault` flag on PriceList for the same reason customer addresses use
  // pointers: a column holds one value, so "two tenant defaults" is not a state the database
  // can represent, and no partial unique index (which Prisma cannot model) is needed.
  defaultPriceListId String?
  defaultPriceList   PriceList?   @relation("TenantDefaultPriceList", fields: [defaultPriceListId, id], references: [id, tenantId])
  StockLevel         StockLevel[]

  @@map("tenants")
}

// Bridges an anonymous registrant (A5) to the tenant they're setting up, before any
// User exists to hold a real Session. Deliberately not reusing Session — a Session's
// whole contract is "belongs to a real authenticated user," which is untrue here.
// Valid until expiresAt OR the tenant's onboardingStep reaches COMPLETE.
model OnboardingSession {
  id        String   @id @default(cuid())
  tenantId  String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("onboarding_sessions")
}

// Store IS the Amburax-side location/warehouse concept — see ERPNEXT_DOCTYPE_MAP.md
// ("Store -> Warehouse/Company setup"). No separate Location/Warehouse model: that would
// be a second, duplicate inventory concept living outside ERPNext, which the architecture
// explicitly forbids. `erpnextProvisionStatus`/`erpnextWarehouseId` mirror Tenant's own
// deferred-ERPNext fields (ADR-038) — no adapter exists yet, so these stay at their
// defaults; nothing here pretends a Warehouse was actually provisioned in ERPNext.
enum StoreType {
  RETAIL
  WAREHOUSE
}

model Store {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  storeType   StoreType @default(RETAIL)
  currency    String
  phone       String?
  addressLine String
  city        String
  state       String
  postalCode  String?
  timezone    String    @default("Asia/Kolkata")
  // True for exactly one store per tenant. Not exposed as a user toggle at A7 (there is
  // nothing to toggle against yet — the first store is trivially the default); future
  // multi-store screens are what make this field meaningful.
  isDefault   Boolean   @default(false)

  erpnextProvisionStatus ErpnextProvisionStatus @default(NOT_PROVISIONED)
  erpnextWarehouseId     String?

  // Per-store bill counter. Incremented inside the sale transaction, so PostgreSQL's row
  // lock serialises concurrent tills and two sales can never take the same number.
  // This is an AMBURAX *retail reference*, NOT an ERPNext invoice number — invoice
  // numbering stays ERPNext-authoritative (ADR-063). See ADR-079.
  nextBillSeq Int @default(1)

  // The same counter, for orders. Deliberately separate from `nextBillSeq`: an order and a
  // sale are different documents, and sharing one sequence would make order SO-000042 and
  // bill SA-000042 unrelated strangers that look like a matched pair. Per store rather than
  // per tenant, so two busy stores never contend on one row.
  nextOrderSeq Int @default(1)

  createdAt DateTime @default(now())

  // The price list this store sells at, tried after the customer's own. Nullable: a store
  // without one falls through to the tenant default and then to the variant's base price,
  // which is exactly how every store behaves today.
  priceListId String?

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  memberships    StoreMembership[]
  invitations    Invitation[]
  posDevices     PosDevice[]
  posSessions    PosSession[]
  sales          Sale[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  priceList      PriceList?        @relation("StorePriceList", fields: [priceListId, tenantId], references: [id, tenantId])
  orders         Order[]
  OutboxEvent    OutboxEvent[]

  @@unique([tenantId, code])
  // Same purpose as User's: the referencable half of StoreMembership's composite foreign
  // key. Adds no new rule about stores on its own.
  @@unique([id, tenantId])
  @@map("stores")
}

// A9's model. A POS terminal is an *operational device* bound to a Store — deliberately
// not a User (a device does not log in, does not hold a role, and must be revocable
// without touching any person's identity), not a Store (a Store has many terminals), and
// not a Warehouse (Store already is the Amburax-side warehouse concept — see the Store
// model above). OFFLINE_POS.md §9 requires exactly this shape: Tenant -> Store -> POS
// Terminal -> Device, so the server can attribute every offline transaction to the device
// that produced it.
//
// The fields are deliberately grouped into three kinds that must not be conflated:
//   IDENTITY       — stable, server-assigned, never re-derived from a browser fingerprint.
//   CREDENTIALS    — two *different* secrets with different lifetimes (see below).
//   CONFIGURATION  — merchant-chosen presentation/hardware behaviour, Amburax-owned.
//   RUNTIME        — volatile, written only by device-facing calls, never by A9's form.
//
// Two distinct credentials, not one:
//   `pairingCodeHash`  — one-time, short-lived, shown to the *owner* once at A9 so they can
//                        pair the physical terminal. Consumed at activation.
//   `deviceSecretHash` — long-lived, issued to the *device* at activation and never shown
//                        to a human. This is what a future POS client authenticates with.
// Neither reuses Session / OnboardingSession / PasswordResetToken / MfaChallenge /
// Invitation: a device credential has a different subject (a machine), a different
// lifetime, and a different revocation story. Only `token.ts`'s hash helper is shared.
//
// Status is derived from nullable timestamps (activatedAt / disabledAt / pairingExpiresAt),
// matching the Invitation/PasswordResetToken convention — one source of truth per fact
// instead of a status column that can drift. Crucially `createdAt` != `activatedAt`: a row
// existing means "the owner configured a terminal", NOT "a physical terminal has claimed
// it". A9 must never report the second when only the first is true.
//
// Revocation is `disabledAt`, never deletion: historical sales will reference `posDeviceId`
// forever, so a compromised terminal must be disableable without destroying its history.
model PosDevice {
  id       String @id @default(cuid())
  tenantId String
  storeId  String

  // --- IDENTITY ---
  // `code` is the logical terminal name the merchant uses on the floor (POS-01, POS-02).
  // Unique per store, not per tenant: two stores may each have their own POS-01.
  name            String
  code            String
  createdByUserId String
  createdAt       DateTime @default(now())

  // --- CREDENTIALS (raw values are never persisted) ---
  pairingCodeHash  String?   @unique
  pairingExpiresAt DateTime?
  deviceSecretHash String?   @unique

  // --- LIFECYCLE (status derived from these) ---
  activatedAt DateTime?
  disabledAt  DateTime?

  // --- RUNTIME (volatile — not configuration) ---
  // Written by device-facing calls only. A heartbeat/online-offline/sync-state model
  // belongs with the offline engine (OFFLINE_POS.md §4), not here; this single column
  // is the minimum A9 needs to tell "activated once" from "actually seen".
  lastSeenAt DateTime?

  // --- CONFIGURATION (Amburax-owned presentation/hardware behaviour) ---
  // Deliberately excludes invoice prefix / start number / default customer / price list,
  // even though the A9 wireframe sketches them: numbering is ERPNext-authoritative
  // (OFFLINE_POS.md §10) and customers/price lists are ERPNext-owned records that no
  // Amburax model or adapter can validate against yet. See DECISIONS.md ADR-063.
  receiptHeader     String?
  receiptFooter     String?
  showProductImages Boolean @default(true)
  scanSoundEnabled  Boolean @default(true)
  cashDrawerEnabled Boolean @default(false)

  // The shift currently open on this till, if any.
  //
  // A pointer rather than a status flag on PosSession, for the reason this schema reaches for
  // repeatedly: a column holds exactly one value, so "two shifts open on one till" is not a
  // state the database can represent. The alternative — a partial unique index over an
  // `isOpen` flag — is something Prisma cannot express without permanent drift, the same wall
  // P1-8E hit with price windows.
  //
  // Cleared on close. The session row survives; only the pointer moves.
  activeSessionId String? @unique

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  store         Store        @relation(fields: [storeId, tenantId], references: [id, tenantId])
  createdBy     User         @relation("PosDevicesCreated", fields: [createdByUserId, tenantId], references: [id, tenantId])
  activeSession PosSession?  @relation("PosDeviceActiveSession", fields: [activeSessionId, tenantId], references: [id, tenantId])
  sessions      PosSession[]

  @@unique([storeId, code])
  // Referencable half for PosSession's composite foreign key, the same shape every other
  // tenant-owned parent carries (invariant I-4).
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([storeId])
  @@map("pos_devices")
}

model User {
  id               String     @id @default(cuid())
  tenantId         String
  email            String     @unique
  passwordHash     String
  name             String
  status           UserStatus @default(ACTIVE)
  tenantRole       TenantRole @default(STAFF)
  mfaEnabled       Boolean    @default(false)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  sessions            Session[]
  memberships         StoreMembership[]
  mfaChallenges       MfaChallenge[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationsSent")
  invitationsAccepted Invitation[]         @relation("InvitationsAccepted")
  posDevicesCreated   PosDevice[]          @relation("PosDevicesCreated")
  salesRung           Sale[]               @relation("SalesRung")
  ordersCreated       Order[]              @relation("OrdersCreated")
  posSessionsRun      PosSession[]         @relation("PosSessionsRun")

  // Target for StoreMembership's composite foreign key. `id` alone is already the primary
  // key, so this adds no new integrity rule about users — it exists solely so PostgreSQL
  // can reference (id, tenantId) as a unit and prove a membership's user really belongs to
  // the tenant that membership claims.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("users")
}

// `role` is a free string (not a schema enum) matching the existing convention since A1 —
// changing its type would touch working A7 infrastructure the brief asked not to rebuild.
// The privilege-escalation guard therefore lives in code, not the column type: see
// src/server/tenant/storeRoles.ts's INVITABLE_STORE_ROLES allow-list, enforced at
// invitation creation (this file) and to be enforced identically wherever A11 later
// creates the membership row from an accepted invitation.
// A user's role at one store.
//
// `tenantId` is not denormalisation for query convenience — it is the field that makes the
// tenant invariant expressible to PostgreSQL. With independent FKs on `userId` and
// `storeId`, a tenant-A user could be given membership of a tenant-B store: both keys were
// individually valid and nothing tied them together. The application never did this,
// because every call site resolves the store through the session's tenant first, but that
// was a convention spread across call sites rather than a rule the database enforced.
//
// The two composite foreign keys below close it. `(userId, tenantId)` must match a real
// `(users.id, users.tenantId)` pair and `(storeId, tenantId)` a real
// `(stores.id, stores.tenantId)` pair, so a row can only exist when the user and the store
// agree on the same tenant. A cross-tenant membership is now rejected by PostgreSQL with a
// foreign-key violation, whatever the calling code believes.
model StoreMembership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  storeId  String
  role     String

  user  User  @relation(fields: [userId, tenantId], references: [id, tenantId])
  store Store @relation(fields: [storeId, tenantId], references: [id, tenantId])

  // Unchanged: one membership per (user, store). Double acceptance of an invitation is
  // still impossible, and this stays the constraint the acceptance path relies on.
  @@unique([userId, storeId])
  @@index([tenantId])
  @@map("store_memberships")
}

// A8's credential: proves "the tenant's owner invited this email to this store with this
// role," nothing more. Deliberately its own model, not a reuse of Session, OnboardingSession,
// PasswordResetToken, or MfaChallenge — see AUTHENTICATION.md's "pre-auth credential types."
// `role` is validated against INVITABLE_STORE_ROLES at creation (never OWNER, never a future
// platform-admin role) — the payload itself cannot be used for privilege escalation.
//
// Status is deliberately derived (not a stored enum) from three nullable timestamps —
// acceptedAt / revokedAt / expiresAt — mirroring PasswordResetToken/MfaChallenge/
// OnboardingSession's established convention, so there's one source of truth per fact
// instead of a status column that could drift from the timestamps.
//
// A11 (not built yet) must accept an invitation with the same atomic-claim shape as A4's
// token-race fix (ADR-031): `updateMany({ where: { id, acceptedAt: null, revokedAt: null,
// expiresAt: { gt: now } }, data: { acceptedAt: now, acceptedByUserId } })` as the first
// statement in its transaction. Documented here so A11 doesn't have to rediscover it.
//
// @@unique([tenantId, storeId, email]) is deliberate, not incidental: it makes "invite
// this email to this store" a single atomic `upsert` rather than a read-then-write
// (check for a pending invite, then create) — the latter raced under concurrent
// double-clicks (two overlapping transactions could each pass the "no pending invite
// yet" check before either committed, producing two live invitations for the same
// email+store). One row per (tenant, store, email) forever, refreshed on every new
// invite, closes that race at the database level instead of trying to out-time it.
model Invitation {
  id               String    @id @default(cuid())
  tenantId         String
  storeId          String
  email            String
  role             String
  inviterUserId    String
  tokenHash        String    @unique
  createdAt        DateTime  @default(now())
  lastSentAt       DateTime  @default(now())
  resendCount      Int       @default(0)
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  store      Store  @relation(fields: [storeId, tenantId], references: [id, tenantId])
  inviter    User   @relation("InvitationsSent", fields: [inviterUserId, tenantId], references: [id, tenantId])
  // Nullable and composite. PostgreSQL's MATCH SIMPLE leaves the constraint unchecked while
  // acceptedByUserId is NULL — an unaccepted invitation — and enforces it the moment one is set.
  acceptedBy User?  @relation("InvitationsAccepted", fields: [acceptedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, storeId, email])
  @@index([tenantId])
  @@index([email])
  @@index([storeId])
  @@map("invitations")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String
  tokenHash String    @unique
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  // Composite: a session for a user of another tenant is not a state PostgreSQL will hold.
  user User @relation(fields: [userId, tenantId], references: [id, tenantId])

  @@index([userId])
  @@map("sessions")
}

// Durable rate-limit + audit source for login/MFA attempts (LoginSucceeded/LoginFailed, MFA verify/resend).
// `context` scopes the IP rate-limit window per attempt type so a burst of OTP
// guesses can't be laundered through the plain-login limiter or vice versa.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  context   String   @default("password")
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, context, createdAt])
  @@map("login_attempts")
}

enum MfaChannel {
  SMS
  WHATSAPP
  EMAIL
}

// One row per OTP challenge issued after a password-correct, MFA-required login.
// tokenHash identifies the challenge to the client (opaque, like Session.tokenHash);
// codeHash is the OTP itself. Neither the raw token nor the raw code is ever persisted.
model MfaChallenge {
  id          String     @id @default(cuid())
  userId      String
  tenantId    String
  tokenHash   String     @unique
  codeHash    String
  channel     MfaChannel @default(SMS)
  attempts    Int        @default(0)
  resendCount Int        @default(0)
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  lastSentAt  DateTime   @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  // Composite, for the same reason Session is: the challenge carries a tenantId, and one that
  // disagrees with the user it names is a contradiction, not a record.
  user User @relation(fields: [userId, tenantId], references: [id, tenantId])

  @@index([userId])
  @@map("mfa_challenges")
}

// One row per password reset request that actually issued a token (silent no-op
// requests — unknown email, disabled account, within cooldown — create no row,
// by design: the response is identical either way, so nothing here should be
// queryable as a "did this email request a reset" oracle beyond what's already
// implied by the user existing at all).
// Issuing a new token supersedes (consumes) every prior unconsumed token for the
// same user — see DECISIONS.md ADR-027. Only one reset link is ever valid at a time.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  // Composite. A reset token is a credential; one whose tenant disagrees with its user is
  // exactly the kind of record an attacker would like to create.
  user User @relation(fields: [userId, tenantId], references: [id, tenantId])

  @@index([userId])
  @@map("password_reset_tokens")
}

// ADR-010's durable outbox. Closes audit finding P1-4.
//
// Why this is NOT AuditLog. `writeAuditLog` uses the global `db` client, so all 53 of its
// call sites write *outside* the business transaction: if the transaction rolls back the
// audit row survives, and if the process dies after committing the mutation the audit row
// never appears. Either way the record and the fact disagree. That is acceptable for an
// operator's action trail, which is what AuditLog is; it is fatal for a domain event,
// which something downstream must act on. The two coexist and mean different things —
// AuditLog answers "who did what", OutboxEvent answers "what must happen next".
//
// The transactional guarantee is the entire point: a row here is INSERTed by the same
// PostgreSQL transaction as the mutation it describes (see events/outbox.ts, which only
// accepts a Prisma.TransactionClient). So the event exists if and only if the business
// change committed. No two-phase commit, no lost events, no phantom events.
//
// Envelope fields are EVENTS.md's "Event requirements" list verbatim: event_id (`id`),
// event_type, event_version, occurred_at, tenant_id, store_id, actor, correlation_id,
// causation_id, entity_id, payload.
//
// Delivery state is derived from nullable timestamps (publishedAt / deadLetteredAt),
// matching the Invitation / PasswordResetToken / PosDevice convention — one source of
// truth per fact instead of a status column that can drift from them.
model OutboxEvent {
  id String @id @default(cuid())

  // --- ENVELOPE ---
  // tenantId is required and FK-enforced: an event that cannot be attributed to a tenant
  // cannot be dispatched safely, and every read path scopes on it.
  tenantId      String
  storeId       String?
  eventType     String
  eventVersion  Int      @default(1)
  occurredAt    DateTime @default(now())
  actorUserId   String?
  correlationId String
  causationId   String?
  entityId      String?
  payload       Json

  // Producer-side deduplication. Deterministically derived from the business fact
  // (tenant + event type + entity + discriminator), so a retried operation that reaches
  // the insert twice is rejected by the database rather than enqueuing a duplicate.
  // Consumer-side idempotency is still required — delivery is at-least-once by design.
  idempotencyKey String @unique

  // --- DELIVERY STATE ---
  // `attempts` and `nextAttemptAt` are advanced by the claim itself, so a dispatcher that
  // crashes mid-publish cannot hot-loop: the row is already scheduled into the future.
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  publishedAt    DateTime?
  deadLetteredAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // The envelope's store must belong to the envelope's tenant. Nullable: most events are not
  // store-scoped, and MATCH SIMPLE leaves those unchecked.
  store  Store? @relation(fields: [storeId, tenantId], references: [id, tenantId])

  // The dispatcher's hot path: unpublished, not dead-lettered, due now, oldest first.
  @@index([publishedAt, deadLetteredAt, nextAttemptAt])
  @@index([tenantId, occurredAt])
  @@map("outbox_events")
}

// -----------------------------------------------------------------------------
// RETAIL COMMERCE DOMAIN
//
// Money is stored as INTEGER MINOR UNITS (paise) everywhere, never as Float. Binary
// floating point cannot represent 0.1 exactly, and a POS that accumulates rounding error
// across a day's takings reconciles to nothing. Every `*Minor` column is an exact integer
// count of the smallest currency unit.
//
// Tax rates are stored in BASIS POINTS (`taxRateBp`): 1800 == 18.00%. Same reasoning.
//
// What this domain does NOT do: it is not an accounting system and not a stock ledger.
// ERPNext remains authoritative for the Sales Invoice, Payment Entry, GL impact and the
// stock ledger (ADR-001, ERPNEXT_ARCHITECTURE.md). These tables hold the AMBURAX retail
// record and the operational projection needed to run a counter - see StockLevel.
// -----------------------------------------------------------------------------

model Product {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  category String?
  brand    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The unit this product's quantities are counted in. Nullable because it arrived after the
  // products did: the migration backfills every existing product with its tenant's PCS, and a
  // product created before a tenant has any unit defined is still a valid product.
  //
  // "Base" is load-bearing. Every stored quantity in the system — SaleItem.quantity,
  // StockLevel.quantity, StockMovement.quantityDelta — is in this unit, always. Packaging
  // units (PACK, DOZEN, CARTON) exist only at the edges, where a person types one, and are
  // converted to base units before anything is stored. Nothing persists a packaging quantity.
  baseUomId String?

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  baseUom  Uom?             @relation(fields: [baseUomId, tenantId], references: [id, tenantId])
  variants ProductVariant[]

  // Referencable half for composite keys, the same shape User, Store and ProductVariant
  // already carry (invariant I-4).
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@map("products")
}

// A unit a tenant counts things in.
//
// Tenant-scoped rather than global: two businesses may both use "BOX" and mean different
// quantities, and a shared catalogue would let one tenant's edit change another's stock. The
// cost is that every tenant defines its own PCS; the migration does that once.
//
// Deliberately NOT a dimensional measurement system. There is no length/mass/volume dimension,
// no SI base units, no unit algebra. A garment business needs to say "a carton holds 24
// pieces", and that is a factor, not a physics engine.
model Uom {
  id       String @id @default(cuid())
  tenantId String

  /// Short operator-facing symbol: PCS, PACK, DOZEN, CARTON. Uppercased on write.
  code String
  name String

  // Metadata only, and deliberately inert in this phase. A unit may declare that it would
  // naturally carry decimals (METRE, KG) so the catalogue can describe reality, but every
  // quantity in this system is still an integer: `convertQuantity` refuses to compute with a
  // unit whose decimalPlaces is greater than zero rather than silently truncating. Enabling
  // fractional quantities is a separate, deliberate migration of every quantity column.
  decimalPlaces Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  products        Product[]
  conversionsFrom UomConversion[] @relation("ConversionFrom")
  conversionsTo   UomConversion[] @relation("ConversionTo")
  priceListItems  PriceListItem[]
  orderItems      OrderItem[]

  @@unique([tenantId, code])
  // Referencable half of the composite foreign keys on Product and UomConversion.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("uoms")
}

// "One `fromUom` contains `factor` of `toUom`."
//
// One direction only, and the direction is the contract: the row always points from the larger
// packaging unit to the smaller counting unit, with `factor` greater than one. `1 DOZEN = 12
// PCS` is a row; `1 PCS = 1/12 DOZEN` is not, because the reverse is derived by division and a
// derived fact does not need storage. Storing both directions would let them disagree.
//
// `factor` is an integer for the same reason every quantity in this system is: exact
// arithmetic. A fractional factor would make `quantity x factor` produce a fractional quantity,
// which nothing here can store.
model UomConversion {
  id       String @id @default(cuid())
  tenantId String

  fromUomId String
  toUomId   String

  /// How many `toUom` are in one `fromUom`. Always >= 2 — see the service's validation.
  factor Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  // Composite, so PostgreSQL proves both units belong to the tenant the conversion claims.
  fromUom Uom    @relation("ConversionFrom", fields: [fromUomId, tenantId], references: [id, tenantId])
  toUom   Uom    @relation("ConversionTo", fields: [toUomId, tenantId], references: [id, tenantId])

  // The database's guarantee against duplicate definitions: one conversion per ordered pair per
  // tenant. Two concurrent creates of the same pair cannot both succeed, so the service never
  // relies on a check-then-insert.
  @@unique([tenantId, fromUomId, toUomId])
  @@index([tenantId, toUomId])
  @@map("uom_conversions")
}

// The sellable unit. A non-garment retailer simply has one variant per product with null
// size/colour - the model stays generic rather than assuming apparel, while `size`/`colour`
// give the garment-first vertical first-class columns instead of burying them in JSON.
model ProductVariant {
  id        String @id @default(cuid())
  tenantId  String
  productId String

  sku     String
  barcode String?
  size    String?
  colour  String?

  // Selling price and MRP in minor units. `taxRateBp` is the rate configured on the
  // variant; the rate actually charged is snapshotted onto the sale line.
  priceMinor Int
  mrpMinor   Int?
  taxRateBp  Int  @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite. A variant of one tenant hanging off another tenant's product would put a
  // foreign product's name and unit on this tenant's sale lines.
  product        Product         @relation(fields: [productId, tenantId], references: [id, tenantId])
  saleItems      SaleItem[]
  orderItems     OrderItem[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  priceListItems PriceListItem[]

  // SKU and barcode are unique per tenant, not globally: two businesses may legitimately
  // use the same SKU string, and a global constraint would leak one tenant's namespace
  // into another's.
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  // Target for StockMovement's composite foreign key, the same shape User and Store already
  // carry for StoreMembership (invariant I-4). `id` is already the primary key, so this adds
  // no new rule about variants — it exists so PostgreSQL can prove a movement's variant
  // really belongs to the tenant that movement claims.
  @@unique([id, tenantId])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model Customer {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// GSTIN, for a customer who buys as a business. Nullable because most retail customers are
  /// not registered, and deliberately NOT unique: two tenants keep independent customer books
  /// and may both sell to the same firm. Stored uppercase and trimmed; no GST verification
  /// service exists, and the format check is a shape check, not proof the number is real.
  gstin String?

  // Which of this customer's addresses to use by default. Pointers rather than a flag on the
  // address, because a column holds exactly one value: "two conflicting default billing
  // addresses" is not a state the database can represent, so no constraint, trigger or
  // application check is needed to prevent it. A partial unique index over an isDefault flag
  // would have been the alternative, and Prisma cannot express one without permanent drift.
  defaultBillingAddressId  String?
  defaultShippingAddressId String?

  /// The price list agreed with this buyer. Highest priority in resolution, and nullable:
  /// a walk-in retail customer has no negotiated pricing and never will.
  priceListId String?

  // --- Commercial profile (W-1) --------------------------------------------------------------
  //
  // Everything below is CONFIGURATION: terms a merchant agreed with a buyer. None of it is
  // accounting state, and nothing in this system computes a balance from it. Outstanding,
  // ageing and receivables are ERPNext's, and until that integration exists any figure AMBURAX
  // derived would be invented.

  /// Retail, wholesale or distributor. Defaults to RETAIL, so existing customers are unchanged.
  customerType CustomerType @default(RETAIL)

  /// Agreed credit period in days — "NET 30" is 30. Null means no terms were agreed, which is
  /// the ordinary case for a walk-in. Not a payment schedule, and nothing computes a due date
  /// from it yet.
  paymentTermsDays Int?

  /// The credit ceiling agreed with this buyer, in integer minor units like every other money
  /// column here.
  ///
  /// **Stored, never enforced.** No order is refused because of it, and no "available credit"
  /// is computed anywhere — doing so would need the outstanding balance, which ERPNext owns and
  /// which this system cannot see. Enforcement is W-7 and requires ERP integration first.
  creditLimitMinor Int?

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  sales           Sale[]
  orders          Order[]
  addressLinks    CustomerAddress[]
  priceList       PriceList?        @relation("CustomerPriceList", fields: [priceListId, tenantId], references: [id, tenantId])
  defaultBilling  Address?          @relation("CustomerDefaultBilling", fields: [defaultBillingAddressId, tenantId], references: [id, tenantId])
  defaultShipping Address?          @relation("CustomerDefaultShipping", fields: [defaultShippingAddressId, tenantId], references: [id, tenantId])

  // Phone is the retail identity key in this market. Unique per tenant so selecting an
  // existing customer can never silently create a duplicate.
  @@unique([tenantId, phone])
  // Referencable half of CustomerAddress's composite foreign key (invariant I-4).
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@map("customers")
}

// A named set of prices a tenant sells at.
//
// The whole of P1-8E is this table, its items, and three nullable pointers at it. There is no
// promotion, coupon, scheme, free-quantity, loyalty or discount engine here, and a price list is
// not a campaign: it has no schedule, no audience and no stacking rules. It answers one question
// — "what does this variant cost, in this unit, at this quantity, today" — and the answer is a
// number somebody typed.
//
// `currency` is required and is never converted. A list priced in one currency simply does not
// apply to a store selling in another; resolution refuses rather than guessing a rate, because
// inventing an exchange rate inside a POS is how money goes missing. There is no FX engine and
// this field does not imply one — it exists so that the day a second currency appears, the rows
// already say which one they meant.
model PriceList {
  id       String @id @default(cuid())
  tenantId String

  name     String
  /// ISO-4217, uppercased on write. Never converted — see the model comment.
  currency String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  items           PriceListItem[]
  customers       Customer[]      @relation("CustomerPriceList")
  stores          Store[]         @relation("StorePriceList")
  tenantDefaultOf Tenant[]        @relation("TenantDefaultPriceList")

  @@unique([tenantId, name])
  // Referencable half of every composite foreign key that points here.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("price_lists")
}

// One price: "in this list, this variant, sold in this unit, at this quantity or more, costs this
// much".
//
// `uomId` is required, not nullable, for a reason that is half domain and half PostgreSQL. The
// domain half: a price without a unit is meaningless once units exist — 950 rupees for a piece
// and 950 for a carton are different businesses. The PostgreSQL half: NULLs are distinct in a
// unique index, so a nullable unit column would silently allow unlimited duplicate rows for the
// same variant and quantity, defeating the one constraint this table most needs.
//
// Quantity breaks are rows, not a separate table: 1, 10 and 50 are three items, and resolution
// picks the highest `minQuantity` that does not exceed what was asked for.
model PriceListItem {
  id       String @id @default(cuid())
  tenantId String

  priceListId String
  variantId   String
  uomId       String

  /// The smallest quantity this price applies from. At least 1.
  minQuantity Int @default(1)

  /// Integer minor units, matching every other money column in this schema. Zero is allowed and
  /// means exactly what it says — a deliberately free line — not a promotion mechanism.
  unitPriceMinor Int

  // Null at either end means "open". Both null is the ordinary case: a price that simply applies.
  // This is a validity window, not a schedule: nothing activates a price at a future date as a
  // campaign, and no job flips these over.
  validFrom DateTime?
  validTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  // Composite throughout (invariant I-4): the list, the variant and the unit must all belong to
  // the tenant that owns the price, and PostgreSQL enforces it rather than the calling code.
  priceList PriceList      @relation(fields: [priceListId, tenantId], references: [id, tenantId])
  variant   ProductVariant @relation(fields: [variantId, tenantId], references: [id, tenantId])
  uom       Uom            @relation(fields: [uomId, tenantId], references: [id, tenantId])

  // The required duplicate protection: one price per list, variant, unit and quantity break.
  // Overlapping validity windows within that key are prevented in the service — see
  // docs/architecture/PRICING.md for why that one cannot be a database constraint here.
  @@unique([priceListId, variantId, uomId, minQuantity])
  @@index([tenantId, variantId])
  @@map("price_list_items")
}

// What an address is for. Three values, not more: a wholesale buyer's invoice goes to their
// registered office and the goods go to a warehouse, and very often both are the same place.
// Finer categories (registered office, branch, godown) are labels a business can keep in
// `contactName` until something in the system actually branches on them.
// What kind of buyer this is. The distinction that makes a wholesale customer a wholesale
// customer, rather than a retail one with a bigger cart.
//
// Defaulted to RETAIL so every existing customer keeps its current meaning and no backfill has
// to guess. A tenant that never sells wholesale simply never changes it.
//
// Deliberately not a "customer group": groups are a W-2 concept with their own pricing
// behaviour, and this is one field on the customer, not a hierarchy.
enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum AddressType {
  BILLING
  SHIPPING
  BOTH
}

// A postal address, owned by a tenant.
//
// Deliberately NOT polymorphic. There is no ownerType/ownerId pair: a string discriminator
// cannot be a foreign key, so the database could not tell a customer address from a supplier
// one, and nothing would stop a row pointing at an id that does not exist. Ownership is
// expressed by real relations — `CustomerAddress` today, and a `SupplierAddress` of the same
// shape whenever suppliers arrive.
//
// Kept international. `state` is free text because "state" is a province in Canada and a county
// in Ireland, and `country` is an ISO-3166 two-letter code. No GST state code: that belongs to
// the tax engine, which does not exist, and adding it later is one nullable column.
model Address {
  id       String @id @default(cuid())
  tenantId String

  line1      String
  line2      String?
  city       String
  /// State, province, county — whatever the country calls its first-level subdivision.
  state      String
  postalCode String
  /// ISO-3166 alpha-2, uppercased on write.
  country    String

  /// Who to ask for at this address. Not the customer's own name, which lives on Customer.
  contactName  String?
  contactPhone String?

  type AddressType

  // Addresses are deactivated, never deleted. Once orders exist they will snapshot the address
  // they shipped to (see docs/architecture/ADDRESS.md); until then, deleting one would still be
  // deleting a piece of a customer's history.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  customerLinks     CustomerAddress[]
  orderSnapshots    OrderAddress[]
  defaultBillingOf  Customer[]        @relation("CustomerDefaultBilling")
  defaultShippingOf Customer[]        @relation("CustomerDefaultShipping")

  // Referencable half of the composite foreign keys on CustomerAddress and Customer.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("addresses")
}

// Which addresses belong to which customer.
//
// A join table rather than `Address.customerId`, because the same physical address can
// legitimately serve more than one relationship — a buyer's group warehouse, a shared godown —
// and because the next owner kind (supplier) gets its own table instead of a nullable column on
// Address that would be null most of the time.
model CustomerAddress {
  id       String @id @default(cuid())
  tenantId String

  customerId String
  addressId  String

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  // Composite on both sides, the StoreMembership pattern: PostgreSQL rejects a link between a
  // tenant-A customer and a tenant-B address because neither pair would resolve.
  customer Customer @relation(fields: [customerId, tenantId], references: [id, tenantId])
  address  Address  @relation(fields: [addressId, tenantId], references: [id, tenantId])

  @@unique([customerId, addressId])
  @@index([tenantId, customerId])
  @@map("customer_addresses")
}

// COMPLETED means AMBURAX holds the sale. It does NOT mean ERPNext posted an invoice -
// `erpSyncStatus` carries that separately and honestly (OFFLINE_POS.md section 16).
enum SaleStatus {
  COMPLETED
  VOIDED
}

enum ErpSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Sale {
  id       String @id @default(cuid())
  tenantId String
  storeId  String

  // Human-facing retail reference, unique per store, allocated from Store.nextBillSeq
  // inside the sale transaction. NOT an ERPNext invoice number (ADR-063 / ADR-079).
  billNumber String

  cashierUserId String
  customerId    String?

  status SaleStatus @default(COMPLETED)

  // Every amount is server-calculated from the variant's stored price. Nothing here is
  // ever taken from the browser - see saleService.ts.
  subtotalMinor Int
  discountMinor Int @default(0)
  taxMinor      Int
  totalMinor    Int
  paidMinor     Int

  // Client-supplied request identity. Unique per tenant, so a double-click, a browser
  // retry or a network retry returns the original sale instead of ringing it twice.
  idempotencyKey String

  // ERPNext is not connected. PENDING is the truthful state, not a placeholder for
  // success - the UI must say "ERP sync pending", never "posted to ERPNext".
  erpSyncStatus ErpSyncStatus @default(PENDING)
  erpInvoiceId  String?

  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  store    Store         @relation(fields: [storeId, tenantId], references: [id, tenantId])
  cashier  User          @relation("SalesRung", fields: [cashierUserId, tenantId], references: [id, tenantId])
  // Nullable — a walk-in sale has no customer — and composite, so a customer that IS named must
  // belong to this tenant. The delete action moves from SetNull to Restrict: a composite key
  // cannot be set to NULL while tenantId is NOT NULL, and nulling it would erase who bought
  // something rather than refuse the delete. Customers are deactivated, never deleted. Same
  // shape Order already uses.
  customer Customer?     @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  items    SaleItem[]
  payments SalePayment[]

  // Which till, in which shift, rang this up. Nullable for two honest reasons: sales predating
  // the POS session model exist, and a sale raised from the back office has no till. Present or
  // absent, never another tenant's — the relation is composite.
  posSessionId String?
  posSession   PosSession? @relation(fields: [posSessionId, tenantId], references: [id, tenantId])

  @@unique([tenantId, idempotencyKey])
  @@unique([storeId, billNumber])
  // The referencable half of SaleItem's composite foreign key, the same shape every other
  // tenant-owned parent carries.
  @@unique([id, tenantId])
  @@index([tenantId, completedAt])
  @@index([storeId, completedAt])
  @@map("sales")
}

// Line values are SNAPSHOTS taken at the moment of sale. A later price change must never
// retroactively alter what a customer was charged, so name, sku and unit price are copied
// here rather than joined from the variant at read time.
model SaleItem {
  id String @id @default(cuid())

  // Added in P1-8H. A sale line references a ProductVariant, and without a tenantId of its own
  // there was no way for PostgreSQL to prove that variant belonged to the sale's tenant — the
  // line could name another tenant's product. Backfilled from the parent sale, which is the
  // only value it could ever have had.
  tenantId String
  saleId   String

  variantId    String
  skuSnapshot  String
  nameSnapshot String

  quantity          Int
  unitPriceMinor    Int
  lineDiscountMinor Int @default(0)
  taxRateBp         Int
  taxMinor          Int
  lineTotalMinor    Int

  sale    Sale           @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId, tenantId], references: [id, tenantId])

  @@index([tenantId, saleId])
  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

// A sale may be settled by more than one tender. No payment gateway is integrated, so
// CASH/UPI/CARD are all operator-confirmed at the counter - `reference` holds a UPI or
// card reference the operator typed. A timeout must never become CONFIRMED.
model SalePayment {
  id     String @id @default(cuid())
  saleId String

  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountMinor Int
  reference   String?
  confirmedAt DateTime?

  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

// AMBURAX OPERATIONAL STOCK PROJECTION - NOT AN AUTHORITATIVE STOCK LEDGER.
//
// ERPNext owns the stock ledger (ADR-001, DATA_OWNERSHIP_MATRIX.md). This table exists so a
// counter can show an on-hand figure and so a sale visibly moves stock, and it is
// explicitly a read/operational projection: no valuation, no costing, no stock entries, no
// accounting impact, and rebuildable from ERPNext once the adapter exists.
//
// It must never be presented as a confirmed global stock figure - the UI labels it as an
// operational count, per OFFLINE_POS.md section 14's "local estimate" rule. See ADR-080.
model StockLevel {
  id        String @id @default(cuid())
  tenantId  String
  storeId   String
  variantId String

  // Signed on purpose: a projection that has drifted negative is information, and clamping
  // it at zero would hide the drift a reconciliation sweep needs to find.
  quantity Int @default(0)

  updatedAt DateTime @updatedAt

  // The projection carried a tenantId with no foreign key at all until P1-8H: nothing stopped a
  // level naming a tenant that did not exist, or a store and variant belonging to someone else.
  // All three are now enforced by PostgreSQL.
  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  store   Store          @relation(fields: [storeId, tenantId], references: [id, tenantId])
  variant ProductVariant @relation(fields: [variantId, tenantId], references: [id, tenantId])

  @@unique([storeId, variantId])
  @@index([tenantId])
  @@map("stock_levels")
}

// Why a movement exists, stated in the row rather than inferred from its sign. A
// reconciliation sweep asking "why is this store three short" needs the reason, and `-3`
// does not carry one.
//
// Deliberately short. These are the movements the shared core can actually produce today.
// Purchase receipts, transfers between stores, manufacturing consumption and job-work issues
// each need an entity that does not exist yet (supplier, warehouse, work order), and naming
// them here would be reserving vocabulary for systems nobody has built.
enum StockMovementType {
  // The balance a store already had when the ledger began. Written once per stock level by
  // the migration that introduced this table, never by application code.
  OPENING_BALANCE
  // Goods arriving. Not a purchase receipt — there is no supplier or purchase order yet —
  // just a controlled, audited increase performed by someone authorised to make it.
  RECEIPT
  // The POS decrement. Produced inside the sale transaction, so it exists if and only if the
  // sale does.
  SALE
  // A correction with a stated reason: damage, theft, shrinkage, a data-entry error.
  ADJUSTMENT
  // The delta between a physical count and the recorded balance. Distinct from ADJUSTMENT
  // because a count is evidence about reality, while an adjustment is an assertion about it.
  STOCK_TAKE
}

// The authoritative inventory ledger. `StockLevel` is its projection.
//
// Before this table, stock could only ever fall: the sole writer in the entire codebase was
// the decrement inside `createSale`, and `StockLevel.quantity` was a bare number with no
// provenance — nothing recorded who changed it, when, why, or from what. A balance that
// cannot explain itself cannot be reconciled against ERPNext's stock ledger when the adapter
// arrives, and cannot be audited at all.
//
// Append-only by convention and by API: nothing in `server/inventory` updates or deletes a
// movement. Corrections are new movements, which is what makes the history true rather than
// merely current.
model StockMovement {
  id       String @id @default(cuid())
  tenantId String
  storeId  String

  variantId String

  type StockMovementType

  // Signed. Positive adds to the balance, negative removes from it. Stored as the delta
  // rather than as a before/after pair because the projection is a running sum, and a pair
  // would let the two disagree.
  //
  // Integer, matching the quantity contract the rest of the system already enforces
  // (`validateQuantity`). Decimal quantities are deferred to the phase that introduces UOM;
  // changing the type here without changing that contract would leave half the system
  // rounding and the other half not.
  quantityDelta Int

  // What the balance became, captured inside the same transaction that applied the delta.
  // Not authoritative — the running sum is — but it makes a ledger readable without
  // replaying it, and makes drift obvious to a sweep comparing the two.
  balanceAfter Int

  // Free text for ADJUSTMENT and STOCK_TAKE. An unexplained correction is indistinguishable
  // from a mistake.
  reason String?

  // What caused this movement, when something did. `SALE` movements carry ("SALE", saleId);
  // an operator-initiated receipt carries nothing, because the movement IS the record.
  referenceType String?
  referenceId   String?

  // Null for movements the system produced without a person — currently only the migration's
  // opening balances.
  actorUserId String?

  // Producer-side deduplication, the same discipline the outbox uses: derived from the
  // business fact rather than randomly generated, so a retried request collides on the
  // unique index instead of double-counting stock. Scoped per tenant.
  idempotencyKey String

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  // Composite foreign keys, following invariant I-4 from the start rather than retrofitting
  // them later: a movement's store and variant must both belong to the tenant the movement
  // claims, and PostgreSQL enforces that regardless of what the calling code believes.
  store   Store          @relation(fields: [storeId, tenantId], references: [id, tenantId])
  variant ProductVariant @relation(fields: [variantId, tenantId], references: [id, tenantId])

  @@unique([tenantId, idempotencyKey])
  // The ledger read path: one store's movements for one variant, newest first.
  @@index([tenantId, storeId, variantId, occurredAt])
  // Answering "what did this sale do to stock".
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// An order's position in its life, and nothing else. Payment state and fulfilment detail are
// separate axes by design: a single enum combining paid/unpaid, shipped/unshipped, invoiced and
// approved would have to enumerate their product, and every new axis would double it.
//
// RESERVED is present because the approved lifecycle names it, and is **deliberately
// unreachable** in this phase. No transition leads to it, and `transitionOrder` refuses it
// explicitly. There is no reservation accounting anywhere in this system — `StockMovementType`
// has no RESERVATION member, `StockLevel` is a plain projection of the ledger sum, and no column
// anywhere records committed-but-unshipped quantity. Allowing an order to say RESERVED would be
// a claim about stock that nothing backs. See docs/architecture/ORDERS.md.
//
// CANCELLED is a terminal state off to one side rather than a step in the sequence, because an
// order can die at several points and none of them is "after FULFILLED".
enum OrderStatus {
  DRAFT
  CONFIRMED
  RESERVED
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
  CANCELLED
}

// Which address on an order a snapshot is. Narrower than `AddressType`, which also has BOTH: an
// order needs to know where to send goods and where to send the bill as two separate answers,
// even when the customer gave one address for both.
enum OrderAddressType {
  BILLING
  SHIPPING
}

// Demand, before anything has been fulfilled.
//
// **This is not a Sale and does not replace one.** A Sale is a completed retail transaction: it
// has moved stock, taken money and produced a bill, all in one instant at a till. An Order is a
// commitment that something will happen — it can be drafted, revised, confirmed, partially met,
// cancelled — and it can exist for days before any of that. Both remain, and the POS still
// creates a Sale directly without going anywhere near this table.
//
// The shape is deliberately capability-neutral. A wholesale order, a channel order and a
// counter order are the same document with different origins, so nothing here is named for a
// module and nothing here is gated behind a capability. Capability-specific workflows will be
// built on top of this, not beside it.
model Order {
  id       String @id @default(cuid())
  tenantId String

  // Required. Pricing resolves against a store (P1-8E reads its currency and price list), the
  // order number is allocated from that store's counter, and an order that belongs to no
  // location cannot answer "at what price, in what currency". A tenant always has at least one
  // store by the time it can trade.
  storeId String

  // Human-facing reference, `STORECODE-SO-000001`, allocated from `Store.nextOrderSeq` inside
  // the creating transaction — the same discipline and the same row lock `billNumber` uses. Not
  // a UUID, because people read these out over the phone. Unique per store, not per tenant:
  // the store code is already in the string.
  orderNumber String

  // Nullable, because a walk-in who orders something to collect later is a real order and has
  // no customer record. Present or absent, never another tenant's — the relation is composite.
  customerId String?

  status OrderStatus @default(DRAFT)

  // The store's currency, copied at creation. An order priced in one currency must not start
  // reading differently because the store was later reconfigured. No conversion happens
  // anywhere; this is a label on money that is already in one currency.
  currency String

  // Sum of the line totals, server-computed, integer minor units.
  //
  // There is no `totalMinor`, and that is not an omission. Tax and discount are deliberately
  // out of scope for this phase — no second tax engine, no second discount engine — so a total
  // would be identical to the subtotal, and a field that means nothing yet is a field code will
  // start trusting. When tax and discount arrive, they arrive with a total.
  subtotalMinor Int @default(0)

  // Optimistic concurrency. Every transition reads this and writes `version + 1` conditionally,
  // so two clients confirming the same order at once cannot both succeed: the loser's update
  // matches zero rows and is reported as a conflict rather than silently overwriting.
  version Int @default(1)

  // Same contract as Sale's: a client-generated key, unique per tenant, so a double-click or a
  // network retry returns the original order instead of creating a second one.
  idempotencyKey String

  createdByUserId String

  // Lifecycle timestamps, nullable because they record events that may not have happened. The
  // status is the authority; these say when it changed. `cancellationReason` is required at
  // cancellation time by the service — an unexplained cancellation is indistinguishable from a
  // mistake, the same reasoning `StockMovement.reason` uses.
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  closedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  store     Store          @relation(fields: [storeId, tenantId], references: [id, tenantId])
  customer  Customer?      @relation(fields: [customerId, tenantId], references: [id, tenantId])
  createdBy User           @relation("OrdersCreated", fields: [createdByUserId, tenantId], references: [id, tenantId])
  items     OrderItem[]
  addresses OrderAddress[]

  @@unique([tenantId, idempotencyKey])
  @@unique([storeId, orderNumber])
  // Referencable half for the children's composite foreign keys (invariant I-4).
  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("orders")
}

// One line of demand: this many of this variant, in this unit, at this price.
//
// Every commercially meaningful value is snapshotted. An order is a record of what was agreed,
// and what was agreed cannot be reconstructed from today's catalogue: prices change, price lists
// are edited, products get renamed, units get retired. `SaleItem` already established this
// discipline with `skuSnapshot`/`nameSnapshot`; this carries it further, because an order lives
// far longer between agreement and completion than a sale does.
model OrderItem {
  id       String @id @default(cuid())
  tenantId String
  orderId  String

  variantId String
  // Required, not nullable, for the same reason P1-8E requires it on a price: a quantity
  // without a unit is meaningless once units exist. Ten of something is not an amount.
  uomId     String

  // Integer, in the unit named above. The system-wide contract from P1-8C: no decimals, no
  // fractional metres, no fractional kilograms.
  quantity Int

  // How much of this line has actually been met. Fulfilment in this phase is **quantity
  // accounting only** — it moves no stock, produces no shipment and knows nothing about
  // picking or couriers. It exists so that PARTIALLY_FULFILLED and FULFILLED are derived from
  // recorded fact rather than set by a client sending a status string.
  fulfilledQuantity Int @default(0)

  // Resolved by the P1-8E pricing service, never accepted from the caller. Provisional while
  // the order is DRAFT; re-resolved and locked at confirmation. See docs/architecture/ORDERS.md.
  unitPriceMinor Int
  lineTotalMinor Int

  // Where that price came from, kept for explicability rather than for recomputation: a
  // merchant asking "why did this line cost that" gets an answer that does not depend on the
  // price list still existing in its old form. Free text rather than a relation for exactly
  // that reason — the list it names may since have been edited or deleted.
  priceSourceSnapshot String?
  priceListIdSnapshot String?

  // The catalogue as it read when the line was agreed. Renaming a product later must not
  // rewrite what a customer ordered.
  skuSnapshot     String
  nameSnapshot    String
  uomCodeSnapshot String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order          @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId, tenantId], references: [id, tenantId])
  uom     Uom            @relation(fields: [uomId, tenantId], references: [id, tenantId])

  // One line per variant and unit. Two lines for the same thing in the same unit are an
  // accident of a retried request, not a business fact, and the database refuses them rather
  // than leaving a reader to decide which is real. The same variant in a different unit is a
  // different line, which is legitimate.
  @@unique([orderId, variantId, uomId])
  @@index([tenantId, orderId])
  @@index([variantId])
  @@map("order_items")
}

// Where the goods go, and where the bill goes, frozen at confirmation.
//
// A full copy, not a reference. `docs/architecture/ADDRESS.md` wrote this rule down before there
// was an order to apply it to: "editing a customer's address afterwards must never rewrite where
// something was already shipped". An order records where goods actually went; the customer's
// address record says where they live today. Conflating them turns a delivery dispute into an
// unanswerable question.
//
// `sourceAddressId` is provenance only — it says which address was copied, and nothing reads
// through it to render the order. The snapshot stands alone even if the source is deactivated.
model OrderAddress {
  id       String @id @default(cuid())
  tenantId String
  orderId  String

  type OrderAddressType

  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String

  contactName  String?
  contactPhone String?

  sourceAddressId String?

  createdAt DateTime @default(now())

  order  Order    @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  source Address? @relation(fields: [sourceAddressId, tenantId], references: [id, tenantId])

  // One billing and one shipping address per order. A second of either could disagree with the
  // first, and no reader could tell which one the goods went to.
  @@unique([orderId, type])
  @@index([tenantId, orderId])
  @@map("order_addresses")
}

// The business modules a tenant may switch on. One tenant, any combination — a shop that also
// sells wholesale is one tenant with two capabilities, not two systems. Nothing here implies a
// separate product, customer or inventory world per capability; the data plane stays shared.
//
// A database enum rather than free text because these identifiers are authorization keys. A
// typo'd string in a capability column would silently mean "no such capability", and the safest
// failure mode for an authorization key is "the database refuses to store it at all". The cost
// is that adding a capability needs a migration, which is the correct amount of friction for a
// list that changes once a year.
//
// Stable identifiers, never display labels. These strings are persisted, compared in backend
// checks, returned in API responses, and written into audit metadata; renaming one is a data
// migration, so they are chosen to be renaming-proof rather than pretty.
//
// Deliberately not versioned, not scoped to a store, and not a feature-flag platform. There are
// no percentages, cohorts, kill switches or expiry dates here.
enum Capability {
  RETAIL
  WHOLESALE
  MANUFACTURING
  JOB_WORK
  PROCUREMENT
  COMMERCE
  DISTRIBUTION
}

// One row per capability a tenant has been configured with.
//
// `enabled` is the single authority. A missing row means the capability was never configured and
// is therefore off; `enabled = false` means it was configured and then switched off. Both read as
// "off" to every caller — `hasCapability` collapses them — but they are kept distinct because
// deleting the row on disable would destroy the record of it ever having been on, and re-enabling
// would look like a first-time grant. Disable is an update, never a delete.
//
// No composite `(id, tenantId)` foreign key as elsewhere in this schema, because there is nothing
// to protect: `tenantId` here is the parent itself, not a sibling that could belong to some other
// tenant. A cross-tenant capability row is not a thing the shape can express.
//
// `@@unique([tenantId, capability])` is the whole integrity story. Two rows for the same tenant
// and capability could disagree about whether the module is on, and a check reading "one of them"
// would be non-deterministic — so the database refuses the second row outright.
//
// A capability is NOT a permission. This table answers "does this tenant have this business
// module"; StoreMembership, TenantRole and the canSell/canManageInventory helpers answer "is this
// user allowed to do this". Both must pass. See docs/architecture/CAPABILITIES.md.
model TenantCapability {
  id         String     @id @default(cuid())
  tenantId   String
  capability Capability
  enabled    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capability])
  @@map("tenant_capabilities")
}

// A cashier's shift on one till.
//
// Three things a retail backend must be able to answer that `Sale` alone cannot: which till rang
// this up, who was on it, and what belongs to the shift that is being handed over. A POS device
// is hardware, a User is a person, a Store is a place, and a Sale is one transaction — a shift is
// the span that ties them together, and it is its own row because it is its own fact.
//
// **This is not cash management.** There is no opening float, no counted drawer, no variance and
// no reconciliation, because none of that has been designed yet and a half-modelled cash drawer
// is worse than none: it invites people to trust a number nobody computed. Closing a session here
// means "this shift is over", not "the till was counted and balanced". When cash management
// arrives it attaches to this row; it does not replace it.
model PosSession {
  id       String @id @default(cuid())
  tenantId String
  storeId  String

  posDeviceId   String
  // Who is on the till. Composite-keyed to the tenant like everything else, so a cashier from
  // another business cannot be recorded as having worked this shift.
  cashierUserId String

  openedAt DateTime  @default(now())
  // Null while the shift is open. Derived state rather than a status column, matching the
  // convention Invitation, PasswordResetToken and PosDevice already use — one source of truth
  // per fact, instead of a flag that can disagree with the timestamp beside it.
  closedAt DateTime?

  // Free text from whoever closed it. Optional, and deliberately not a money figure.
  closingNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  store     Store       @relation(fields: [storeId, tenantId], references: [id, tenantId])
  posDevice PosDevice   @relation(fields: [posDeviceId, tenantId], references: [id, tenantId])
  cashier   User        @relation("PosSessionsRun", fields: [cashierUserId, tenantId], references: [id, tenantId])
  sales     Sale[]
  activeOn  PosDevice[] @relation("PosDeviceActiveSession")

  // Referencable half for Sale's and PosDevice's composite foreign keys (invariant I-4).
  @@unique([id, tenantId])
  @@index([tenantId, storeId, openedAt])
  @@index([posDeviceId, openedAt])
  @@map("pos_sessions")
}

model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String?
  userId        String?
  action        String
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
