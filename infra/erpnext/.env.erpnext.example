# Secrets for infra/erpnext/docker-compose.yml. Copy to .env.erpnext (gitignored) and fill in.
# Never commit the real file.

# MariaDB root password (db container, and the backend's DB_ROOT/MARIADB_ROOT variables).
DB_ROOT_PASSWORD=change-me

# Administrator password used only when create-site first creates the "frontend" site.
ERP_ADMIN_PASSWORD=change-me
