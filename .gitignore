# --- existing rules (preserved) ---
node_modules/
.next/
.env
.env.local
*.log

# --- environment / secrets ---
.env.*
!.env.example

# --- build & generated output ---
dist/
build/
out/
coverage/
tsconfig.tsbuildinfo
*.tsbuildinfo
next-env.d.ts.bak

# --- database dumps & local databases ---
*.sql
# ...but Prisma migrations ARE source code and must always be committed.
# Without this exception the `*.sql` dump rule silently swallows every migration,
# which is exactly how a "reproducible migrations" commit ends up containing no SQL.
!**/prisma/migrations/**/*.sql
*.dump
*.sqlite
*.sqlite3
*.db

# --- certificates & private keys ---
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks

# --- OS metadata ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE / editor metadata ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- misc local ---
.cache/
.turbo/
*.local
