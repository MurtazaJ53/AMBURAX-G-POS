# --- existing rules (preserved) ---
node_modules/
.next/
.env
.env.local
*.log

# --- environment / secrets ---
.env.*
!.env.example

# --- build & generated output ---
dist/
build/
out/
coverage/
tsconfig.tsbuildinfo
*.tsbuildinfo
next-env.d.ts.bak

# --- database dumps & local databases ---
*.sql
# ...but Prisma migrations ARE source code and must always be committed.
# Without this exception the `*.sql` dump rule silently swallows every migration,
# which is exactly how a "reproducible migrations" commit ends up containing no SQL.
!**/prisma/migrations/**/*.sql
*.dump
*.sqlite
*.sqlite3
*.db

# --- certificates & private keys ---
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks

# --- OS metadata ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE / editor metadata ---
.vscode/
.idea/
*.swp
*.swo
*~
# Local state written by an authoring tool, not AMBURAX source: machine-specific config and
# a hook cache. Committing it would version one developer's tooling state as if it were part
# of the product.
.impeccable/

# --- misc local ---
.cache/
.turbo/
*.local

# --- browser end-to-end test output ---
test-results/
playwright-report/
blob-report/
.playwright/
# --- browser end-to-end test output ---
test-results/
playwright-report/
blob-report/
.playwright/

# --- scratch & uploads ---
/scratch/
/apps/web/public/uploads/
apps/web/prisma/seedRealShop*.ts
apps/web/prisma/connectRealShop*.ts
apps/web/prisma/record_migration_history.cjs
*.tmp
